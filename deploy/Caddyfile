{
	admin off
}

{$DIRT_PUBLIC_HOST} {
	encode zstd gzip
	request_body {
		max_size 4MB
	}

	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), publickey-credentials-create=(self), publickey-credentials-get=(self), usb=()"
	}

	route {
		@private path /healthz /internal /internal/*
		respond @private 404

		reverse_proxy 127.0.0.1:3000
	}
}
