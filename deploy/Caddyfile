{
	admin off
	servers {
		# MCP POST requests can mutate world state, so reject replayable TLS early data.
		0rtt off
		# Leave room below Node's 16 KiB parser limit for proxy-added headers.
		max_header_size 12KiB
		strict_sni_host on
		timeouts {
			read_body 2m
			read_header 10s
		}
	}
}

http:// {
	respond 400
}

{$DIRT_PUBLIC_HOST} {
	encode zstd gzip
	request_body {
		max_size 4MiB
	}

	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), publickey-credentials-create=(self), publickey-credentials-get=(self), usb=()"
	}

	route {
		@private path /healthz /internal /internal/*
		respond @private 404

		reverse_proxy 127.0.0.1:3000
	}
}
