{
  "name": "dirt-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "AI access to live Minecraft worlds",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kkd16/dirt-mcp.git"
  },
  "scripts": {
    "build": "pnpm --filter @dirt-mcp/server run build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run validate && pnpm run test && pnpm run package:check",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm run lint:code && pnpm run lint:shell && pnpm run lint:workflows && pnpm run lint:markdown",
    "lint:code": "oxlint mcp-server/src --type-aware && oxlint mcp-server/test scripts/*.mjs",
    "lint:markdown": "markdownlint-cli2",
    "lint:shell": "shellcheck scripts/dev-paper scripts/run-dirt-mcp scripts/run-paper-dev scripts/validate-paper-jar scripts/validate-paper-log",
    "lint:workflows": "actionlint",
    "package:check": "publint --strict mcp-server",
    "test": "pnpm --filter @dirt-mcp/server run test",
    "validate": "pnpm run validate:openapi",
    "validate:openapi": "redocly lint --lint-config=error"
  },
  "devDependencies": {
    "@redocly/cli": "2.46.1",
    "markdownlint-cli2": "0.23.2",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.23"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26"
  }
}
