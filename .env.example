# Permanent DNS name used by Caddy, OAuth metadata, and the WebAuthn RP ID.
# Changing it after passkey enrollment requires a deliberate credential reset.
DIRT_PUBLIC_HOST=dirt.example.com

# These are paths to local secret files, not secret values. Each file must
# contain its own independently generated high-entropy value and be mode 0444
# inside a mode-0700 directory so the non-root container can read the bind mount.
DIRT_AUTH_SECRET_FILE=./secrets/auth-secret
DIRT_BRIDGE_TOKEN_FILE=./secrets/bridge-token
DIRT_CONTROL_TOKEN_FILE=./secrets/control-token
