# Keep lifecycle behavior independent of user-level Overmind settings.
OVERMIND_DAEMONIZE=1
OVERMIND_NETWORK=unix
OVERMIND_SOCKET=$PWD/.dev/overmind.sock
OVERMIND_PROCFILE=$PWD/Procfile
OVERMIND_PROCESSES=
OVERMIND_IGNORED_PROCESSES=
OVERMIND_FORMATION=
OVERMIND_AUTO_RESTART=
OVERMIND_STOP_SIGNALS=
OVERMIND_SHELL=sh
OVERMIND_CONTROL_MODE=
OVERMIND_TMUX_CONFIG=
OVERMIND_SKIP_ENV=1
OVERMIND_ENV=
OVERMIND_NO_PORT=1
# Keep a failed component's pane and logs available for component-only repair.
OVERMIND_ANY_CAN_DIE=1
# Leave headroom for an admitted 300-second bridge mutation to drain.
OVERMIND_TIMEOUT=315

DIRT_PUBLIC_ORIGIN=http://localhost:3000
DIRT_DATABASE_PATH=$PWD/.dev/dirt.sqlite3
DIRT_AUTH_SECRET_FILE=$PWD/.dev/secrets/auth-secret
DIRT_BRIDGE_TOKEN_FILE=$PWD/.dev/paper/plugins/DirtMCP/secrets/bridge-token
DIRT_BRIDGE_URL=http://127.0.0.1:8765
DIRT_CONTROL_TOKEN_FILE=$PWD/.dev/paper/plugins/DirtMCP/secrets/control-token
