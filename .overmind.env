OVERMIND_DAEMONIZE=1
OVERMIND_SOCKET=$PWD/.dev/overmind.sock
OVERMIND_SKIP_ENV=1
OVERMIND_NO_PORT=1
OVERMIND_ANY_CAN_DIE=1
OVERMIND_TIMEOUT=315

DIRT_PUBLIC_ORIGIN=http://localhost:3000
DIRT_DATABASE_PATH=$PWD/.dev/dirt.sqlite3
DIRT_AUTH_SECRET_FILE=$PWD/.dev/secrets/auth-secret
DIRT_BRIDGE_TOKEN_FILE=$PWD/.dev/secrets/bridge-token
DIRT_CONTROL_TOKEN_FILE=$PWD/.dev/secrets/control-token
