#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
token_file="${repo_root}/paper-plugin/run/.dirt-mcp-token"
managed_config_dir="${repo_root}/paper-plugin/run/plugins/DirtMCP"

if [[ $# -ne 2 ]]; then
  printf 'Usage: %s MC_PORT BRIDGE_PORT\n' "$0" >&2
  exit 2
fi
DIRT_MCP_BRIDGE_TOKEN=''
if [[ -f "${token_file}" ]]; then
  DIRT_MCP_BRIDGE_TOKEN="$(<"${token_file}")"
fi
if [[ ! "${DIRT_MCP_BRIDGE_TOKEN}" =~ ^[0-9a-f]{64}$ ]]; then
  printf 'Dirt MCP token not found or invalid. Run make reload to create one and restart Paper with it.\n' >&2
  exit 1
fi

export PAPER_EULA=true
export DIRT_MCP_DEV_PORT="$1"
export DIRT_MCP_BRIDGE_PORT="$2"
export DIRT_MCP_BRIDGE_TOKEN

# The managed server is disposable and always runs against this checkout's
# complete strict configuration schema.
mkdir -p "${managed_config_dir}"
cp "${repo_root}/paper-plugin/src/main/resources/config.yml" \
  "${managed_config_dir}/config.yml"

cd "${repo_root}"
exec ./gradlew :paper-plugin:runServer
