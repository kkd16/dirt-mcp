#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
token_file="${repo_root}/paper-plugin/run/.dirt-bridge-token"
control_token_file="${repo_root}/paper-plugin/run/.dirt-control-token"
managed_config_dir="${repo_root}/paper-plugin/run/plugins/DirtMCP"
managed_fawe_config_dir="${repo_root}/paper-plugin/run/plugins/FastAsyncWorldEdit"
managed_paper_config_dir="${repo_root}/paper-plugin/run/config"

if [[ $# -ne 0 ]]; then
  printf 'Usage: %s\n' "$0" >&2
  exit 2
fi
DIRT_BRIDGE_TOKEN=''
if [[ -f "${token_file}" ]]; then
  DIRT_BRIDGE_TOKEN="$(<"${token_file}")"
fi
if [[ ! "${DIRT_BRIDGE_TOKEN}" =~ ^[0-9a-f]{64}$ ]]; then
  printf 'Dirt bridge token not found or invalid. Run make reload to create the development credentials.\n' >&2
  exit 1
fi
DIRT_CONTROL_TOKEN=''
if [[ -f "${control_token_file}" ]]; then
  DIRT_CONTROL_TOKEN="$(<"${control_token_file}")"
fi
if [[ ! "${DIRT_CONTROL_TOKEN}" =~ ^[0-9a-f]{64}$ ]]; then
  printf 'Dirt control token not found or invalid. Run make reload to create the development credentials.\n' >&2
  exit 1
fi

export PAPER_EULA=true
export DIRT_BRIDGE_PORT=8765
export DIRT_BRIDGE_TOKEN
export DIRT_CONTROL_TOKEN

# The managed server is disposable and always runs against this checkout's
# complete strict Dirt configuration schema and pinned dependency test settings.
mkdir -p "${managed_config_dir}" "${managed_fawe_config_dir}" "${managed_paper_config_dir}"
cp "${repo_root}/paper-plugin/src/main/resources/config.yml" \
  "${managed_config_dir}/config.yml"
cp "${repo_root}/scripts/managed-fawe-config.yml" \
  "${managed_fawe_config_dir}/config.yml"
cp "${repo_root}/scripts/managed-paper-global.yml" \
  "${managed_paper_config_dir}/paper-global.yml"

cd "${repo_root}"
exec ./gradlew :paper-plugin:runServer
