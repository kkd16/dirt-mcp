#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
token_file="${repo_root}/paper-plugin/run/.dirt-mcp-token"
state_file="${repo_root}/paper-plugin/run/.dirt-mcp-dev-state"

DIRT_MCP_BRIDGE_TOKEN=''
if [[ -f "${token_file}" ]]; then
  DIRT_MCP_BRIDGE_TOKEN="$(<"${token_file}")"
fi
if [[ ! "${DIRT_MCP_BRIDGE_TOKEN}" =~ ^[0-9a-f]{64}$ ]]; then
  printf 'Dirt MCP token not found or invalid. Run make reload to create one and restart Paper with it.\n' >&2
  exit 1
fi
export DIRT_MCP_BRIDGE_TOKEN

invalid_state() {
  printf 'Invalid managed development state in %s. Run make down, then make up to recreate it.\n' \
    "${state_file}" >&2
  exit 1
}

if [[ -z "${DIRT_MCP_BRIDGE_URL:-}" && -f "${state_file}" ]]; then
  state_mc_port=''
  state_bridge_port=''
  state_mc_port_seen=false
  state_bridge_port_seen=false
  while IFS='=' read -r key value || [[ -n "${key}" || -n "${value}" ]]; do
    case "${key}" in
      MC_PORT)
        [[ "${state_mc_port_seen}" == false ]] || invalid_state
        state_mc_port_seen=true
        state_mc_port="${value}"
        ;;
      BRIDGE_PORT)
        [[ "${state_bridge_port_seen}" == false ]] || invalid_state
        state_bridge_port_seen=true
        state_bridge_port="${value}"
        ;;
      *) invalid_state ;;
    esac
  done < "${state_file}"

  if [[ ! "${state_mc_port}" =~ ^[0-9]+$ ]] \
    || (( 10#${state_mc_port} < 1 || 10#${state_mc_port} > 65535 )) \
    || [[ ! "${state_bridge_port}" =~ ^[0-9]+$ ]] \
    || (( 10#${state_bridge_port} < 1 || 10#${state_bridge_port} > 65535 )); then
    invalid_state
  fi
  DIRT_MCP_BRIDGE_URL="http://127.0.0.1:${state_bridge_port}"
fi
DIRT_MCP_BRIDGE_URL="${DIRT_MCP_BRIDGE_URL:-http://127.0.0.1:8765}"
export DIRT_MCP_BRIDGE_URL

exec node "${repo_root}/mcp-server/dist/index.js"
