#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
run_dir="${repo_root}/paper-plugin/run"
token_file="${run_dir}/.dirt-mcp-token"
state_file="${run_dir}/.dirt-mcp-dev-state"
session_name="dirt-mcp-$(printf '%s' "${repo_root}" | cksum | awk '{ print $1 }')"
startup_timeout=120
shutdown_timeout=120

usage() {
  printf 'Usage: %s {up MC_PORT BRIDGE_PORT|restart MC_PORT BRIDGE_PORT|down|status|health|logs [LINES]|console|command COMMAND}\n' "$0" >&2
  exit 2
}

require_tmux() {
  command -v tmux >/dev/null || {
    printf 'tmux is required for the managed development server.\n' >&2
    exit 1
  }
}

require_bridge_runtime() {
  require_tmux
  command -v curl >/dev/null || {
    printf 'curl is required for development server health checks.\n' >&2
    exit 1
  }
  [[ -s "${token_file}" ]] || {
    printf 'Dirt MCP token not found. Run make dev-token first.\n' >&2
    exit 1
  }
}

validate_port() {
  local name="$1"
  local value="$2"
  if [[ ! "${value}" =~ ^[0-9]+$ ]] || (( value < 1 || value > 65535 )); then
    printf '%s must be an integer between 1 and 65535.\n' "${name}" >&2
    exit 1
  fi
}

write_state() {
  local mc_port="$1"
  local bridge_port="$2"
  mkdir -p "${run_dir}"
  umask 077
  printf 'MC_PORT=%s\nBRIDGE_PORT=%s\n' "${mc_port}" "${bridge_port}" > "${state_file}"
}

read_state() {
  [[ -f "${state_file}" ]] || {
    printf 'Development server state not found. Run make up first.\n' >&2
    exit 1
  }

  state_mc_port=''
  state_bridge_port=''
  while IFS='=' read -r key value; do
    case "${key}" in
      MC_PORT) state_mc_port="${value}" ;;
      BRIDGE_PORT) state_bridge_port="${value}" ;;
      *)
        printf 'Invalid development server state in %s.\n' "${state_file}" >&2
        exit 1
        ;;
    esac
  done < "${state_file}"

  validate_port MC_PORT "${state_mc_port}"
  validate_port BRIDGE_PORT "${state_bridge_port}"
}

session_exists() {
  command -v tmux >/dev/null && tmux has-session -t "${session_name}" 2>/dev/null
}

send_console_command() {
  local command_text="$1"
  [[ "${command_text}" != *$'\n'* && "${command_text}" != *$'\r'* ]] || {
    printf 'Console command must be a single line.\n' >&2
    exit 1
  }
  tmux send-keys -t "${session_name}" -l -- "${command_text}"
  tmux send-keys -t "${session_name}" Enter
}

bridge_healthy() {
  local bridge_port="$1"
  local token
  token="$(<"${token_file}")"
  curl --fail --silent --output /dev/null \
    --connect-timeout 1 \
    --max-time 2 \
    --header "Authorization: Bearer ${token}" \
    "http://127.0.0.1:${bridge_port}/v1/ping"
}

recent_logs() {
  local lines="${1:-100}"
  if session_exists; then
    tmux capture-pane -p -t "${session_name}" -S "-${lines}" | tail -n "${lines}"
  elif [[ -f "${run_dir}/logs/latest.log" ]]; then
    tail -n "${lines}" "${run_dir}/logs/latest.log"
  else
    printf 'No development server logs are available.\n' >&2
  fi
}

start_server() {
  local mc_port="$1"
  local bridge_port="$2"
  validate_port MC_PORT "${mc_port}"
  validate_port BRIDGE_PORT "${bridge_port}"

  if session_exists; then
    read_state
    if bridge_healthy "${state_bridge_port}"; then
      printf 'Dirt MCP development server is already ready on Minecraft port %s and bridge port %s.\n' \
        "${state_mc_port}" "${state_bridge_port}"
      return
    fi
    printf 'The managed tmux session exists but its bridge is unhealthy. Run make logs.\n' >&2
    exit 1
  fi

  if bridge_healthy "${bridge_port}"; then
    printf 'Bridge port %s is already served by an unmanaged process.\n' "${bridge_port}" >&2
    exit 1
  fi

  write_state "${mc_port}" "${bridge_port}"
  tmux new-session -d -x 200 -y 50 -s "${session_name}" -c "${repo_root}" \
    "exec bash scripts/run-paper-dev ${mc_port} ${bridge_port}"
  tmux set-option -t "${session_name}" history-limit 10000 >/dev/null

  local deadline=$((SECONDS + startup_timeout))
  while (( SECONDS < deadline )); do
    if bridge_healthy "${bridge_port}"; then
      printf 'Dirt MCP development server is ready on Minecraft port %s and bridge port %s.\n' \
        "${mc_port}" "${bridge_port}"
      return
    fi
    if ! session_exists; then
      printf 'Development server exited before becoming ready.\n' >&2
      recent_logs 100 >&2
      exit 1
    fi
    sleep 0.5
  done

  printf 'Development server did not become healthy within %s seconds.\n' "${startup_timeout}" >&2
  recent_logs 100 >&2
  exit 1
}

stop_server() {
  if ! session_exists; then
    printf 'Dirt MCP development server is already stopped.\n'
    return
  fi

  tmux send-keys -t "${session_name}" -l -- stop
  tmux send-keys -t "${session_name}" Enter

  local deadline=$((SECONDS + shutdown_timeout))
  while (( SECONDS < deadline )); do
    if ! session_exists; then
      printf 'Dirt MCP development server stopped cleanly.\n'
      return
    fi
    sleep 0.5
  done

  printf 'Development server did not stop within %s seconds; it was left running.\n' \
    "${shutdown_timeout}" >&2
  exit 1
}

restart_server() {
  local default_mc_port="$1"
  local default_bridge_port="$2"
  local mc_port="${default_mc_port}"
  local bridge_port="${default_bridge_port}"

  validate_port MC_PORT "${default_mc_port}"
  validate_port BRIDGE_PORT "${default_bridge_port}"
  if [[ -f "${state_file}" ]]; then
    read_state
    mc_port="${state_mc_port}"
    bridge_port="${state_bridge_port}"
  fi

  local was_running=false
  local shutdown_log_start=0
  local shutdown_log_identity=''
  local current_log_identity=''
  local current_log_lines=0
  if session_exists; then
    was_running=true
    if [[ -f "${run_dir}/logs/latest.log" ]]; then
      shutdown_log_start="$(wc -l < "${run_dir}/logs/latest.log")"
      shutdown_log_identity="$(stat -c '%d:%i' "${run_dir}/logs/latest.log")"
    fi
    send_console_command 'kick @a Server restarting for a Dirt MCP update. Please reconnect in a moment.'
  fi
  stop_server
  if [[ "${was_running}" == true ]]; then
    if [[ -n "${shutdown_log_identity}" && -f "${run_dir}/logs/latest.log" ]]; then
      current_log_identity="$(stat -c '%d:%i' "${run_dir}/logs/latest.log")"
      current_log_lines="$(wc -l < "${run_dir}/logs/latest.log")"
      if [[ "${current_log_identity}" != "${shutdown_log_identity}" ]] \
        || (( current_log_lines < shutdown_log_start )); then
        shutdown_log_start=0
      fi
    fi
    "${repo_root}/scripts/validate-paper-log" shutdown "${shutdown_log_start}"
  fi
  start_server "${mc_port}" "${bridge_port}"
}

status_server() {
  read_state
  if ! session_exists; then
    printf 'Dirt MCP development server is stopped (Minecraft %s, bridge %s).\n' \
      "${state_mc_port}" "${state_bridge_port}"
    return 1
  fi
  if ! bridge_healthy "${state_bridge_port}"; then
    printf 'Dirt MCP development server is running but unhealthy (Minecraft %s, bridge %s).\n' \
      "${state_mc_port}" "${state_bridge_port}"
    return 1
  fi
  printf 'Dirt MCP development server is ready (Minecraft %s, bridge %s, tmux %s).\n' \
    "${state_mc_port}" "${state_bridge_port}" "${session_name}"
}

health_server() {
  read_state
  local token
  token="$(<"${token_file}")"
  curl --fail --silent --show-error \
    --connect-timeout 1 \
    --max-time 2 \
    --header "Authorization: Bearer ${token}" \
    "http://127.0.0.1:${state_bridge_port}/v1/ping"
  printf '\n'
}

case "${1:-}" in
  up)
    [[ $# -eq 3 ]] || usage
    require_bridge_runtime
    start_server "$2" "$3"
    ;;
  restart)
    [[ $# -eq 3 ]] || usage
    require_bridge_runtime
    restart_server "$2" "$3"
    ;;
  down)
    [[ $# -eq 1 ]] || usage
    require_tmux
    stop_server
    ;;
  status)
    [[ $# -eq 1 ]] || usage
    require_bridge_runtime
    status_server
    ;;
  health)
    [[ $# -eq 1 ]] || usage
    require_bridge_runtime
    health_server
    ;;
  logs)
    [[ $# -le 2 ]] || usage
    lines="${2:-100}"
    [[ "${lines}" =~ ^[1-9][0-9]*$ ]] || usage
    recent_logs "${lines}"
    ;;
  console)
    [[ $# -eq 1 ]] || usage
    require_tmux
    session_exists || {
      printf 'Dirt MCP development server is not running.\n' >&2
      exit 1
    }
    exec tmux attach-session -t "${session_name}"
    ;;
  command)
    [[ $# -ge 2 ]] || usage
    require_tmux
    session_exists || {
      printf 'Dirt MCP development server is not running.\n' >&2
      exit 1
    }
    shift
    command_text="$*"
    send_console_command "${command_text}"
    ;;
  *) usage ;;
esac
