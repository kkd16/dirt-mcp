{
  "name": "@dirt-mcp/server",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP stdio bridge for Dirt MCP",
  "license": "Apache-2.0",
  "bin": {
    "dirt-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "pretest": "npm run build",
    "start": "node dist/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
