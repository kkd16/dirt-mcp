{
  "name": "@dirt-mcp/server",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP stdio bridge for Dirt MCP",
  "license": "Apache-2.0",
  "bin": {
    "dirt-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "check": "pnpm run build && tsc -p tsconfig.test.json",
    "pretest": "pnpm run check",
    "start": "node dist/index.js",
    "test": "node --test --experimental-test-coverage --test-coverage-include=dist/**/*.js --test-coverage-include-all --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 test/*.test.ts",
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
